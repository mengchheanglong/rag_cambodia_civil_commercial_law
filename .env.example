# Environment Configuration for RAG Cambodia Law
# Copy this file to .env and fill in the values

# =====================================================================
# DeepSeek (Recommended default)
# =====================================================================
# Flash model (fast & affordable): deepseek-chat
# Pro model (deep legal reasoning): deepseek-reasoner
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# =====================================================================
# OpenAI (Alternative)
# =====================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1

# =====================================================================
# PostgreSQL + pgvector
# =====================================================================
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rag_cambodia_law
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =====================================================================
# Retrieval Settings
# =====================================================================
DENSE_TOP_K=50
SPARSE_TOP_K=50
RERANK_TOP_K=5
RRF_K=60
HYBRID_WEIGHT_DENSE=0.5
HYBRID_WEIGHT_SPARSE=0.5

# =====================================================================
# Reranker
# =====================================================================
RERANKER_MODEL=BAAI/bge-reranker-large
# COHERE_API_KEY=your-cohere-key-here  # Uncomment if using Cohere Rerank

# =====================================================================
# Application
# =====================================================================
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
